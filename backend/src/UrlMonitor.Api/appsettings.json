{
  "ConnectionStrings": {
    "Monitor": "Data Source=monitor.db"
  },
  "Monitor": {
    "SchedulerEnabled": true,
    "CheckIntervalMinutes": 5,
    "TimeoutSeconds": 10,
    "MaxBodyBytes": 5242880,
    "MaxConcurrency": 10,
    "SeedUrls": []
  },
  "Alerts": {
    "FailureThreshold": 2,
    "CooldownMinutes": 30,
    "SendRecoveryEmails": true
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 2525,
    "Security": "None",
    "Username": "",
    "Password": "",
    "From": "url-monitor@localhost",
    "TimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
